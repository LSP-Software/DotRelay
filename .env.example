# Development credentials. In production use a strong password, e.g. from
# `openssl rand -hex 24`.
DATABASE_URL=postgresql://dotrelay:dotrelay@127.0.0.1:5432/dotrelay
SHADOW_DATABASE_URL=postgresql://dotrelay:dotrelay@127.0.0.1:5432/dotrelay_shadow
# Required in production: protocol routes fail closed without Valkey.
VALKEY_URL=redis://127.0.0.1:6379
# Development default only. Production rejects it and the dotrelay:dotrelay
# database credentials above; generate a profile id once with `uuidgen`.
SERVER_PROFILE_ID=00000000-0000-4000-8000-000000000001
SERVER_PROFILE_ORIGIN=https://relay.example
WEB_ORIGIN=https://relay.example
# Web deployment profile. DotRelay's own dev/prod web images declare "hosted"
# at build time; on a self-hosted instance leave it unset so the web app
# treats its backend as a self-hosted Server Profile.
# NEXT_PUBLIC_DOTRELAY_WEB_PROFILE=hosted
# Production rejects this placeholder. Generate a secret with
# `openssl rand -base64 48` (at least 32 characters, 16 distinct).
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Set only when TLS is terminated by the listed trusted reverse proxies.
SERVER_PROFILE_TRUST_PROXY=false
# Comma-separated IP addresses or CIDR ranges. Required with trust proxy in production.
SERVER_PROFILE_TRUSTED_PROXIES=
# Cookie domain shared by the API and web hosts, e.g. example.com for app.example.com and
# api.example.com. It must equal or be a parent of both hosts. Leave unset to share cookies only
# when one host is the parent of the other (web example.com, API api.example.com); otherwise
# cookies stay host-only. Never set it to a shared platform domain other tenants can serve from.
# COOKIE_DOMAIN=
# Set briefly and intentionally when moving a persisted profile to a new origin.
SERVER_PROFILE_REBIND=false
# Local callback example: http://localhost:3001/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Alpha access: stable numeric GitHub user ids, separated by commas.
# API images require this list by default. An explicitly empty value denies all users.
# To deliberately run a public/self-hosted service without the gate, set ALPHA_ADMISSION_REQUIRED=false.
# ALPHA_ADMISSION_REQUIRED=true
# ALPHA_GITHUB_IDS=22797936
