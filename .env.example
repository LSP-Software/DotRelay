DATABASE_URL=postgresql://dotrelay:dotrelay@127.0.0.1:5432/dotrelay
SHADOW_DATABASE_URL=postgresql://dotrelay:dotrelay@127.0.0.1:5432/dotrelay_shadow
VALKEY_URL=redis://127.0.0.1:6379
SERVER_PROFILE_ID=00000000-0000-4000-8000-000000000001
SERVER_PROFILE_ORIGIN=https://relay.example
WEB_ORIGIN=https://relay.example
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Set only when TLS is terminated by the listed trusted reverse proxies.
SERVER_PROFILE_TRUST_PROXY=false
# Comma-separated IP addresses or CIDR ranges. Required with trust proxy in production.
SERVER_PROFILE_TRUSTED_PROXIES=
# Set briefly and intentionally when moving a persisted profile to a new origin.
SERVER_PROFILE_REBIND=false
# Local callback example: http://localhost:3001/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
