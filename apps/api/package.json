{
  "name": "@dotrelay/api",
  "private": true,
  "scripts": {
    "dev": "bun --hot --env-file=../../.env run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "smoke": "bun ../../scripts/smoke-api.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint",
    "typecheck": "bun check",
    "test:unit": "bun test"
  },
  "dependencies": {
    "@dotrelay/contracts": "workspace:*",
    "@dotrelay/database": "workspace:*",
    "better-auth": "1.7.7",
    "hono": "4.13.11",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@dotrelay/client": "workspace:*",
    "@types/pg": "8.23.1",
    "pg": "8.23.1"
  }
}
