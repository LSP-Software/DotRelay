{
  "name": "@dotrelay/api",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "smoke": "bun ../../scripts/smoke-api.ts",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "bun test",
    "db:validate": "bun ../../scripts/validate-prisma.ts",
    "db:migrate-check": "bun ../../scripts/check-migrations.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
