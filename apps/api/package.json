{
  "name": "@dotrelay/api",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "smoke": "bun ../../scripts/smoke-api.ts",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "bun test"
  },
  "dependencies": {
    "@dotrelay/contracts": "workspace:*",
    "@dotrelay/database": "workspace:*",
    "better-auth": "^1.7.1",
    "hono": "4.13.3"
  }
}
