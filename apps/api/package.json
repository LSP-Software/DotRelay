{
  "name": "@dotrelay/api",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "smoke": "bun ../../scripts/smoke-api.ts",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "bun x prisma generate --config prisma.config.ts && tsc --project tsconfig.json",
    "test:unit": "bun test",
    "db:validate": "bun ../../scripts/validate-prisma.ts",
    "db:migrate-check": "bun ../../scripts/check-migrations.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.1",
    "@dotrelay/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.7.1",
    "hono": "4.12.34",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.0"
  }
}
