{
  "name": "@dotrelay/cli",
  "private": true,
  "bin": {
    "dotrelay": "dist/dotrelay"
  },
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "build": "bun run ../../scripts/build-cli.ts",
    "smoke": "bun ../../scripts/smoke-cli.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint",
    "typecheck": "bun check",
    "test:unit": "bun test",
    "test:cli": "bun ../../scripts/test-cli.ts"
  },
  "dependencies": {
    "@dotrelay/client": "workspace:*",
    "@dotrelay/contracts": "workspace:*",
    "@dotrelay/database": "workspace:*"
  }
}
