{
  "name": "@dotrelay/cli",
  "private": true,
  "bin": {
    "dotrelay": "dist/dotrelay"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile src/index.ts --outfile dist/dotrelay",
    "smoke": "bun ../../scripts/smoke-cli.ts",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "bun test",
    "test:cli": "bun ../../scripts/test-cli.ts"
  },
  "dependencies": {
    "@dotrelay/client": "workspace:*",
    "@dotrelay/contracts": "workspace:*",
    "@dotrelay/database": "workspace:*"
  }
}
