{
  "name": "@dotrelay/web",
  "private": true,
  "scripts": {
    "dev": "bun run build:worker && next dev",
    "build:worker": "bun scripts/build-argon2-worker.ts",
    "build": "next build",
    "smoke": "bun ../../scripts/smoke-web.ts",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "bun test app lib",
    "test:e2e": "playwright test --config=../../playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dotrelay/client": "workspace:*",
    "@dotrelay/contracts": "workspace:*",
    "@dotrelay/database": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.21.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7"
  }
}
