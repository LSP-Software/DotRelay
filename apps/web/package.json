{
  "name": "@dotrelay/web",
  "private": true,
  "scripts": {
    "dev": "bun run build:worker && next dev",
    "build:worker": "bun scripts/build-argon2-worker.ts",
    "build": "bun run build:worker && next build",
    "smoke": "bun ../../scripts/smoke-web.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun ../../scripts/lint.ts",
    "typecheck": "bun check",
    "test:unit": "bun test app lib",
    "test:e2e": "playwright test --config=../../playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dotrelay/client": "workspace:*",
    "@dotrelay/contracts": "workspace:*",
    "@dotrelay/database": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.9.2",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7"
  }
