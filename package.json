{
  "name": "dotrelay",
  "private": true,
  "packageManager": "bun@1.4.4-canary.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "issues:panel": "bun scripts/run-issues-panel.ts",
    "issues:panel:test": "bun test scripts/run-issues-panel.test.ts",
    "issues:run": "./run-issues.sh",
    "package:cli": "bun scripts/stage-cli-package.ts",
    "package:cli:version": "bun scripts/set-cli-version.ts",
    "smoke": "turbo run smoke",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "format:fix": "bun fmt",
    "lint": "bun lint",
    "lint:fix": "bun lint --fix",
    "typecheck": "bun check --no-script && turbo run typecheck",
    "boundaries": "bun scripts/verify-boundaries.ts",
    "vectors:verify-sources": "bun scripts/verify-vector-sources.ts",
    "vectors:generate": "bun scripts/generate-v3-vectors.ts",
    "test:unit": "bun test scripts/run-issues.test.ts scripts/run-issues-panel.test.ts scripts/verify-boundaries.test.ts scripts/contracts-vectors.test.ts scripts/contracts-browser.test.ts scripts/client-browser.test.ts scripts/publish-cli.test.ts && turbo run test:unit",
    "test:runner": "bun test scripts/run-issues.test.ts",
    "openapi:check": "bun scripts/check-openapi.ts",
    "test:integration": "bun scripts/test-integration.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:cli": "turbo run test:cli --filter=@dotrelay/cli",
    "test:cli:live": "bun scripts/test-cli-live.ts",
    "test:e2e:full": "bun scripts/test-e2e-full.ts",
    "prisma:generate": "bun x prisma generate --config packages/database/prisma.config.ts",
    "db:validate": "bun scripts/validate-prisma.ts",
    "db:migrate-check": "bun scripts/check-migrations.ts",
    "db:cutover-guard": "bun scripts/guard-legacy-recovery-cutover.ts",
    "docs:validate": "bun scripts/validate-docs.ts",
    "tracked-tree:clean": "bun scripts/check-tracked-tree.ts",
    "security:audit": "bun audit --ignore GHSA-vfj7-8cjw-p6xm",
    "postinstall": "bun run prisma:generate",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run boundaries && bun run openapi:check && bun run vectors:verify-sources && bun run test:unit",
    "verify": "bun run check && bun run build && bun run smoke && bun run test:integration && bun run test:e2e && bun run test:cli && bun run test:cli:live && bun run db:validate && bun run db:migrate-check && bun run docs:validate && bun run tracked-tree:clean"
  },
  "devDependencies": {
    "@dotrelay/client": "workspace:*",
    "@dotrelay/contracts": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.4",
    "@types/sanitize-html": "2.16.1",
    "ioredis": "5.11.1",
    "marked": "18.0.13",
    "postgres": "3.4.9",
    "prisma": "7.9.1",
    "sanitize-html": "2.18.1",
    "turbo": "2.10.11",
    "typescript6": "npm:@typescript/typescript6@6.0.2"
  },
  "overrides": {
    "deepmerge": "4.1.2",
    "deepmerge-ts": "8.0.2",
    "find-my-way": "9.7.0",
    "fast-uri": "3.1.9",
    "mysql2": "3.24.2",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "valibot": "1.4.2"
  }
}
