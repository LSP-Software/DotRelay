{
  "name": "@dotrelay/database",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint",
    "typecheck": "bun x prisma generate --config prisma.config.ts && bun check",
    "test:unit": "bun test src",
    "test:integration": "bun test src/persistence/account-key.integration.test.ts src/persistence/postgres.integration.test.ts src/persistence/publication-scope.integration.test.ts src/persistence/trust.integration.test.ts",
    "db:validate": "bun ../../scripts/validate-prisma.ts",
    "db:migrate-check": "bun ../../scripts/check-migrations.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.7",
    "@dotrelay/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "@dotrelay/client": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "prisma": "7.9.1"
  }
}
