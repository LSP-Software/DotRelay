{
  "name": "@dotrelay/database",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "bun x prisma generate --config prisma.config.ts && tsc --project tsconfig.json",
    "test:unit": "bun test src",
    "db:validate": "bun ../../scripts/validate-prisma.ts",
    "db:migrate-check": "bun ../../scripts/check-migrations.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1"
  }
}
